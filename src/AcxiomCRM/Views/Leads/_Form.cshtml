@model LeadFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="LeadName" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
        <input asp-for="LeadName" class="form-control" />
        <span asp-validation-for="LeadName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" type="tel" inputmode="numeric" maxlength="10" class="form-control" aria-describedby="phoneHelp" />
        <div id="phoneHelp" class="form-text">10-digit mobile number starting with 6–9.</div>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
        <select asp-for="Status" class="form-select"
                asp-items="@(Model.AllowedStatuses.Select(s => new SelectListItem(s.ToString(), s.ToString())))"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Source" class="form-label"></label>
        <select asp-for="Source" asp-items="Html.GetEnumSelectList<LeadSource>()" class="form-select">
            <option value="">—</option>
        </select>
        <span asp-validation-for="Source" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<LeadPriority>()" class="form-select">
            <option value="">—</option>
        </select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ExpectedValue" class="form-label"></label>
        <input asp-for="ExpectedValue" type="number" step="0.01" min="0" max="100000000" class="form-control" />
        <span asp-validation-for="ExpectedValue" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="AssignedTo" class="form-label"></label>
        @if (Model.Assignees.Count > 1)
        {
            <select asp-for="AssignedTo" asp-items="Model.Assignees" class="form-select"></select>
        }
        else
        {
            <input type="hidden" asp-for="AssignedTo" />
            <p class="form-control-plaintext">@(Model.Assignees.FirstOrDefault()?.Text)</p>
        }
        <span asp-validation-for="AssignedTo" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
</div>
