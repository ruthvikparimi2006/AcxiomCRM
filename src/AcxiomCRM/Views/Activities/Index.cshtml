@model ActivityIndexViewModel
@{ ViewData["Title"] = "Activities"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Activities</h1>
    <a asp-action="Create" class="btn btn-primary">Log activity</a>
</div>

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-6 col-md-2">
        <label for="type" class="form-label small mb-0">Type</label>
        <select id="type" name="type" class="form-select">
            <option value="">Any</option>
            @foreach (var t in Enum.GetValues<ActivityType>())
            {
                <option value="@t" selected="@(Model.Type == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="from" class="form-label small mb-0">From</label>
        <input id="from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="to" class="form-label small mb-0">To</label>
        <input id="to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="status" class="form-label small mb-0">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">Any</option>
            @foreach (var s in Enum.GetValues<ActivityStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-sm-8 col-md-3">
        <label for="assignedTo" class="form-label small mb-0">Assigned user</label>
        <select id="assignedTo" name="assignedTo" class="form-select">
            <option value="">Anyone</option>
            @foreach (var u in Model.Users)
            {
                <option value="@u.Value" selected="@(Model.AssignedTo == u.Value)">@u.Text</option>
            }
        </select>
    </div>
    <div class="col-sm-4 col-md-1 d-flex align-items-end"><button type="submit" class="btn btn-outline-secondary w-100">Search</button></div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <partial name="_SortHeader" model='new SortHeader("Date", "date")' />
                <th scope="col">Type</th>
                <partial name="_SortHeader" model='new SortHeader("Subject", "subject")' />
                <th scope="col">Related to</th>
                <th scope="col">Assigned To</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Activities.Items)
            {
                <tr>
                    <td>@a.Date.ToString("g")</td>
                    <td>@a.Type</td>
                    <td><a asp-action="Details" asp-route-id="@a.Id">@a.Subject</a></td>
                    <td>@string.Join(" / ", new[] { a.CustomerName, a.LeadName }.Where(n => n is not null))</td>
                    <td>@a.AssignedName</td>
                    <td>@a.Status</td>
                </tr>
            }
            @if (Model.Activities.TotalCount == 0)
            {
                <tr><td colspan="6" class="text-muted">No activities found.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pagination" model="Model.Activities" />
