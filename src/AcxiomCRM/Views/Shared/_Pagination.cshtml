@model IPagedList
@{
    // Keeps the current search/filter/sort and only swaps the page number.
    string PageUrl(int page)
    {
        var query = Context.Request.Query.ToDictionary(q => q.Key, q => (string?)q.Value.ToString());
        query["page"] = page.ToString();
        return Context.Request.Path + QueryString.Create(query).ToString();
    }
    var first = Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var last = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <p class="text-muted mb-0" aria-live="polite">Showing @first–@last of @Model.TotalCount</p>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Model.Page - 1)" aria-disabled="@(Model.Page == 1 ? "true" : null)">Previous</a>
                </li>
                <li class="page-item active" aria-current="page">
                    <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Model.Page + 1)" aria-disabled="@(Model.Page == Model.TotalPages ? "true" : null)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
