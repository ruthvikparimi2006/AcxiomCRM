@if (User.Identity?.IsAuthenticated == true)
{
    var role = Roles.All.FirstOrDefault(User.IsInRole);
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @User.Identity.Name
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            @if (role is not null)
            {
                <li><span class="dropdown-item-text text-muted small">Role: @role</span></li>
                <li><hr class="dropdown-divider" /></li>
            }
            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item">Log out</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
    </ul>
}
