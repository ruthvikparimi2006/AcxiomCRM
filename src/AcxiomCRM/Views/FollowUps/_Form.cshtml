@model FollowUpFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<fieldset class="row g-3 mb-0">
    <legend class="form-label fs-6 mb-0">Related to <span class="text-danger" aria-hidden="true">*</span> <span class="text-muted small">(choose one: a customer, a lead or an opportunity)</span></legend>
    <div class="col-md-4">
        <label asp-for="CustomerId" class="form-label"></label>
        <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
            <option value="">—</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="LeadId" class="form-label"></label>
        <select asp-for="LeadId" asp-items="Model.Leads" class="form-select">
            <option value="">—</option>
        </select>
        <span asp-validation-for="LeadId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="OpportunityId" class="form-label"></label>
        <select asp-for="OpportunityId" asp-items="Model.Opportunities" class="form-select">
            <option value="">—</option>
        </select>
        <span asp-validation-for="OpportunityId" class="text-danger"></span>
    </div>
</fieldset>
<div class="row g-3 mt-0">
    <div class="col-md-4">
        <label asp-for="FollowUpDate" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
        <input asp-for="FollowUpDate" type="date" class="form-control" min="@NotBeforeTodayAttribute.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="FollowUpDate" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="FollowUpType" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
        <select asp-for="FollowUpType" asp-items="Html.GetEnumSelectList<ActivityType>()" class="form-select">
            <option value="">—</option>
        </select>
        <span asp-validation-for="FollowUpType" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="AssignedTo" class="form-label"></label>
        @if (Model.Assignees.Count > 1)
        {
            <select asp-for="AssignedTo" asp-items="Model.Assignees" class="form-select"></select>
        }
        else
        {
            <input type="hidden" asp-for="AssignedTo" />
            <p class="form-control-plaintext">@(Model.Assignees.FirstOrDefault()?.Text)</p>
        }
        <span asp-validation-for="AssignedTo" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Subject" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
</div>
