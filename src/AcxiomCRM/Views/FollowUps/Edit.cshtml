@model FollowUpFormViewModel
@{
    ViewData["Title"] = "Edit follow-up";
    var id = ViewContext.RouteData.Values["id"];
}

<h1 class="h3 mb-3">Edit follow-up</h1>
<form asp-action="Edit" asp-route-id="@id" method="post" novalidate>
    <partial name="_Form" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Details" asp-route-id="@id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
