@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
@section Head {
    @* Keep the reset token out of Referer headers. *@
    <meta name="referrer" content="no-referrer" />
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Reset password</h1>
        <form asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" />
                <div id="passwordHelp" class="form-text">@PasswordRules.Message</div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Set new password</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
