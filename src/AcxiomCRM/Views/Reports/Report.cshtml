@model ReportViewModel
@{
    ViewData["Title"] = Model.Info.Title;
    static string Format(object? v) => v switch
    {
        null => "—",
        decimal d => d.ToString("N2"),
        DateTime t => t.ToString("g"),
        DateOnly d => d.ToString("d"),
        _ => v.ToString() ?? "",
    };
    static bool IsNumber(object? v) => v is decimal or int;
}

<div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-1">
    <h1 class="h3 mb-0">@Model.Info.Title</h1>
    <a asp-action="Index">All reports</a>
</div>
<p class="text-muted">@Model.Info.Description</p>

<form method="get" class="row g-2 mb-3 align-items-end" aria-label="Report filters">
    <div class="col-sm-6 col-md-2">
        <label for="from" class="form-label small mb-0">@Model.DateLabel from</label>
        <input id="from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="to" class="form-label small mb-0">to</label>
        <input id="to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label for="ownerId" class="form-label small mb-0">User</label>
        <select id="ownerId" name="ownerId" class="form-select">
            <option value="">Anyone</option>
            @foreach (var u in Model.Owners)
            {
                <option value="@u.Value" selected="@(Model.OwnerId == u.Value)">@u.Text</option>
            }
        </select>
    </div>
    @if (Model.ShowGroupBy)
    {
        <div class="col-sm-6 col-md-2">
            <label for="groupBy" class="form-label small mb-0">Group by</label>
            <select id="groupBy" name="groupBy" class="form-select">
                <option value="stage" selected="@(Model.GroupBy == "stage")">Stage</option>
                <option value="owner" selected="@(Model.GroupBy == "owner")">Owner</option>
            </select>
        </div>
    }
    <div class="col-sm-6 col-md-2"><button type="submit" class="btn btn-outline-secondary w-100">Apply</button></div>
</form>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                @for (var i = 0; i < Model.Columns.Length; i++)
                {
                    <partial name="_SortHeader" model="new SortHeader(Model.Columns[i], i.ToString())" />
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows.Items)
            {
                <tr>
                    @foreach (var cell in row)
                    {
                        <td class="@(IsNumber(cell) ? "text-end" : "")">@Format(cell)</td>
                    }
                </tr>
            }
            @if (Model.Rows.TotalCount == 0)
            {
                <tr><td colspan="@Model.Columns.Length" class="text-muted">No data for these filters.</td></tr>
            }
        </tbody>
        @if (Model.Totals is { } totals && Model.Rows.TotalCount > 0)
        {
            <tfoot>
                <tr class="fw-semibold">
                    @foreach (var cell in totals)
                    {
                        <td class="@(IsNumber(cell) ? "text-end" : "")">@(cell is null ? "" : Format(cell))</td>
                    }
                </tr>
            </tfoot>
        }
    </table>
</div>
<partial name="_Pagination" model="Model.Rows" />
