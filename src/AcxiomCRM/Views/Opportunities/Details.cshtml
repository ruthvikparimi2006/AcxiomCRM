@model OpportunityDetailsViewModel
@{
    var o = Model.Opportunity;
    ViewData["Title"] = o.OpportunityName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">
        @o.OpportunityName
        <span class="align-middle fs-6"><partial name="_StageBadge" model="o.Stage" /></span>
        <span class="badge text-bg-light border align-middle fs-6">@o.Status</span>
    </h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@o.OpportunityId" class="btn btn-outline-primary">Schedule follow-up</a>
        <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-primary">Edit</a>
        <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" data-confirm="Delete this opportunity? It will be removed from lists but kept for history.">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9"><a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId">@Model.CustomerName</a></dd>
    <dt class="col-sm-3">Lead</dt>
    <dd class="col-sm-9">
        @if (o.LeadId is { } leadId)
        {
            <a asp-controller="Leads" asp-action="Details" asp-route-id="@leadId">@Model.LeadName</a>
        }
        else
        {
            <text>—</text>
        }
    </dd>
    <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@o.Amount.ToString("N2")</dd>
    <dt class="col-sm-3">Probability</dt><dd class="col-sm-9">@o.Probability%</dd>
    <dt class="col-sm-3">Weighted amount</dt><dd class="col-sm-9">@((o.Amount * o.Probability / 100m).ToString("N2"))</dd>
    <dt class="col-sm-3">Expected close</dt><dd class="col-sm-9">@o.ExpectedCloseDate.ToString("D")</dd>
    <dt class="col-sm-3">Closed</dt><dd class="col-sm-9">@(o.ClosedDate?.ToLocalTime().ToString("g") ?? "—")</dd>
    <dt class="col-sm-3">Source</dt><dd class="col-sm-9">@(o.Source?.ToString() ?? "—")</dd>
    <dt class="col-sm-3">Assigned to</dt><dd class="col-sm-9">@Model.AssignedName</dd>
    <dt class="col-sm-3">Notes</dt><dd class="col-sm-9" style="white-space: pre-line">@(o.Notes ?? "—")</dd>
</dl>

<h2 class="h5 mt-4">History</h2>
<ul class="list-group">
    @foreach (var h in Model.History)
    {
        <li class="list-group-item">
            <div class="d-flex justify-content-between">
                <strong>@h.Action</strong>
                <span class="text-muted small">@h.When.ToLocalTime().ToString("g") · @(h.UserName ?? "System")</span>
            </div>
            @if (h.Changes is not null)
            {
                <div class="small text-break">@h.Changes</div>
            }
        </li>
    }
</ul>
<p class="mt-3"><a asp-action="Index">Back to opportunities</a></p>
