@model CustomerIndexViewModel
@{ ViewData["Title"] = "Customers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    <a asp-action="Create" class="btn btn-primary">New customer</a>
</div>

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-md-7">
        <label for="search" class="visually-hidden">Search</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Name, email, phone or company" />
    </div>
    <div class="col-md-3">
        <label for="status" class="visually-hidden">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">Any status</option>
            @foreach (var s in Enum.GetValues<CustomerStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary w-100">Search</button></div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <partial name="_SortHeader" model='new SortHeader("Code", "code")' />
                <partial name="_SortHeader" model='new SortHeader("Name", "name")' />
                <partial name="_SortHeader" model='new SortHeader("Company", "company")' />
                <th scope="col">Email</th>
                <th scope="col">Phone</th>
                <partial name="_SortHeader" model='new SortHeader("Owner", "owner")' />
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Customers.Items)
            {
                <tr>
                    <td>@c.Code</td>
                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.Name</a></td>
                    <td>@c.Company</td>
                    <td>@c.Email</td>
                    <td>@c.Phone</td>
                    <td>@c.OwnerName</td>
                    <td><span class="badge @(c.Status == CustomerStatus.Active ? "text-bg-success" : "text-bg-secondary")">@c.Status</span></td>
                </tr>
            }
            @if (Model.Customers.TotalCount == 0)
            {
                <tr><td colspan="7" class="text-muted">No customers found.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pagination" model="Model.Customers" />
