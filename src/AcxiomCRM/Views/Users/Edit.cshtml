@model UserFormViewModel
@{
    ViewData["Title"] = "Edit user";
    var id = ViewContext.RouteData.Values["id"];
}

<div class="row">
    <div class="col-lg-6">
        <h1 class="h3 mb-3">Edit user</h1>
        <form asp-action="Edit" asp-route-id="@id" method="post" novalidate>
            <partial name="_Form" />
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Details" asp-route-id="@id" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
